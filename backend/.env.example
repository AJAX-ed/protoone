ENVIRONMENT=development
APP_NAME=Secure JEE/NEET Self-Study MVP

DATABASE_URL=postgresql+psycopg2://app_user:changeme@db:5432/appdb

JWT_SECRET_KEY=replace_with_a_long_random_secret_at_least_32_bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

CSRF_SECRET_KEY=replace_with_another_long_random_secret

ALLOWED_ORIGINS=["http://localhost:3000"]

RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=5/minute

REDIS_URL=redis://redis:6379/0

BCRYPT_ROUNDS=12

# PostgreSQL container credentials (for docker-compose)
POSTGRES_USER=app_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=appdb
